# ==========================================
# 悠数 · 电商财务管理系统 环境配置
# 复制此文件为 .env 并修改
# ==========================================

# 数据库 (默认 SQLite，无需改动即可运行)
DATABASE_URL=sqlite+aiosqlite:///./yovus_finance.db
# 如使用 PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/yovus_finance

# JWT密钥
SECRET_KEY=your-secret-key-change-in-production

# 应用配置
APP_ENV=development
APP_DEBUG=false

# AI 分析 (可选 - 配置后启用 AI 深度分析)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
