# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/yovus_finance

# Redis配置 (Celery异步任务)
REDIS_URL=redis://localhost:6379/0

# JWT密钥
SECRET_KEY=your-secret-key-change-in-production

# 应用配置
APP_ENV=development
APP_DEBUG=true

# 税务配置 (一般纳税人)
DEFAULT_VAT_RATE=0.13
SMALL_VAT_RATE=0.03
